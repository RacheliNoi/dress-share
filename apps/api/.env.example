# Copy to .env and adjust as needed.

# Matches docker-compose.yml's default local Postgres credentials.
DATABASE_URL="postgresql://dressshare:dressshare_dev@localhost:5432/dressshare?schema=public"

# Used to sign JWT auth tokens. Use a long, random value in any real deployment.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional, defaults to 3001.
PORT=3001

# CORS: the frontend origin allowed to call this API. Defaults to the local
# dev frontend - set this to the real production frontend URL on deploy.
FRONTEND_URL="http://localhost:3000"

# Optional. Used only for links inside real emails (password reset,
# "someone's interested" etc.) - deliberately separate from FRONTEND_URL
# above, which needs to stay the local frontend in dev for CORS. Falls back
# to FRONTEND_URL (so production, where they're the same URL, never needs
# this set) - only actually needed in local dev, when sending real emails
# through a real RESEND_API_KEY, so those links don't point at
# http://localhost:3000 (dead for anyone opening the email elsewhere).
PUBLIC_APP_URL=""

# Google Cloud Vision API (photo-2: blurs whoever is wearing the dress in an
# uploaded photo, for their privacy) - optional. Face blurring already works
# for free without this, via a local model (BlazeFace) that runs on the
# server itself; this only adds a Vision fallback for photos the local model
# misses. Requires billing enabled on the Google Cloud project the key
# belongs to.
GOOGLE_VISION_API_KEY="AIza..."

# Resend API (notif-1: real transactional email). Without a verified sending
# domain in the Resend dashboard, real recipient addresses are rejected
# (422) and notifications fall back to a [dev-only] console log instead -
# the app still works fine either way, emails just aren't delivered yet.
RESEND_API_KEY="re_..."

# Cloudflare R2 (infra-1: dress photo storage). Without these (or if R2 is
# unreachable), photo uploads fall back to local disk under apps/api/uploads
# automatically - the app still works fine either way. R2_PUBLIC_URL is the
# custom domain connected to the bucket for public reads, not the raw
# R2_ACCOUNT_ID endpoint (that one needs signed requests).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
