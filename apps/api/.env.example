# Copy to .env and adjust as needed.

# Matches docker-compose.yml's default local Postgres credentials.
DATABASE_URL="postgresql://dressshare:dressshare_dev@localhost:5432/dressshare?schema=public"

# Used to sign JWT auth tokens. Use a long, random value in any real deployment.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional, defaults to 3001.
PORT=3001

# Photoroom API (photo-1: AI photo enhancement). Sandbox key is free (up to
# 1000 images/month) but watermarks output - used as the dev/test default.
# Live key gives 10 free non-watermarked edits, then needs billing - only
# for a final quality check before shipping.
PHOTOROOM_API_KEY_SANDBOX="sandbox_sk_pr_..."
PHOTOROOM_API_KEY_LIVE="sk_pr_..."

# Resend API (notif-1: real transactional email). Without a verified sending
# domain in the Resend dashboard, real recipient addresses are rejected
# (422) and notifications fall back to a [dev-only] console log instead -
# the app still works fine either way, emails just aren't delivered yet.
RESEND_API_KEY="re_..."
