generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum DressStatus {
  DRAFT
  AI_PROCESSING
  AI_READY
  OWNER_REVIEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum DressPendingAction {
  ADD
  REMOVE
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String?
  name                String?
  role                UserRole             @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  clothingItems       ClothingItem[]
  dresses             Dress[]
  bookings            Booking[]
  passwordResetTokens PasswordResetToken[]
  bookingMessages     BookingMessage[]
}

// A password-reset request creates exactly one of these rows. Only a hash of
// the token is ever stored - the raw token is single-use and lives only in
// the (future) reset email / dev log. The row is deleted as soon as it is
// used, so "single-use" and "invalidated after reset" both fall out of the
// row simply no longer existing.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClothingItem {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  size      String?
  color     String?
  imageUrl  String?
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Dress {
  id              Int         @id @default(autoincrement())
  name            String
  description     String?
  category        String?
  color           String?
  status          DressStatus @default(DRAFT)
  rejectionReason String?
  ownerId         Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Editing-an-approved-dress support (Stage: approved-edit + re-approval).
  // `status` is intentionally left at APPROVED for the entire edit/review
  // cycle - the public catalog query (findApproved) filters on `status`
  // alone and is never touched by this feature, so it keeps showing the
  // live name/description/category/color and the live (pendingAction: null)
  // sizes/photos throughout, with zero changes to that read path.
  // pendingDetails holds the proposed new scalar values while an edit is
  // being drafted/reviewed; null otherwise. pendingReviewSubmittedAt is null
  // while the owner is still drafting (freely editable, not visible to
  // admin), and set the moment the edit is submitted for admin review
  // (locks further edits, surfaces it in the admin queue - mirrors
  // PENDING_APPROVAL's role for brand-new dresses, without reusing `status`
  // itself so the public read path never has to branch on it).
  pendingDetails           Json?
  pendingReviewSubmittedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  photos             DressPhoto[]
  sizes              DressSize[]
  bookings           Booking[]
  availabilityBlocks DressAvailabilityBlock[]

  @@index([ownerId])
  @@index([status])
}

model DressPhoto {
  id           Int      @id @default(autoincrement())
  dressId      Int
  originalUrl  String
  processedUrl String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  // null = live/unaffected. ADD = proposed new photo, hidden from the public
  // until the edit is approved. REMOVE = an existing live photo flagged for
  // removal - stays fully visible to the public (row and file both untouched)
  // until approval actually deletes it, so an in-review edit never affects
  // what's currently shown.
  pendingAction DressPendingAction?

  dress Dress @relation(fields: [dressId], references: [id], onDelete: Cascade)

  @@index([dressId])
}

model DressSize {
  id        Int      @id @default(autoincrement())
  dressId   Int
  size      String
  price     Int
  // Physical units available for this size (e.g. M x 3). Defaults to 1 so
  // every pre-existing row keeps behaving exactly as it did under the old
  // implicit-single-unit model. Enforced >= 1 at the database level via a
  // hand-added CHECK (see this model's migration.sql) - this Prisma
  // version's schema DSL has no @@check attribute.
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same ADD/REMOVE meaning as DressPhoto.pendingAction. Editing an existing
  // live size's label/price is modeled as REMOVE-flagging the live row plus
  // creating a new ADD-flagged row with the proposed values, rather than
  // mutating the live row in place - so the public price/label never changes
  // before an admin approves it.
  pendingAction DressPendingAction?

  dress Dress @relation(fields: [dressId], references: [id], onDelete: Cascade)

  // pendingAction is part of the unique key (not just [dressId, size]) so a
  // live "M" (pendingAction: null) and a proposed replacement "M"
  // (pendingAction: ADD) can coexist as distinct rows while an edit is being
  // drafted/reviewed - Postgres treats each NULL as distinct, so this still
  // prevents two simultaneous live rows or two simultaneous pending-ADD rows
  // for the same size.
  @@unique([dressId, size, pendingAction])
  @@index([dressId])
}

// Represents a date range during which a Dress is held - anywhere from a
// loose fitting-coordination interest (INTERESTED) to a finalized rental
// (RENTED). One row is meant to live through that whole lifecycle: it can
// start sparse (no renter/size/price yet) and get filled in as it firms up,
// rather than needing a separate table per stage. renterId/size/price stay
// optional for exactly that reason - only dressId + the date range + status
// are guaranteed to be set.
//
// The composite (dressId, startDate, endDate) index exists specifically so a
// future overlap query - "is this dress free between X and Y" - can be
// answered with a single indexed range scan; no overlap-checking logic is
// implemented yet, this stage only prepares for it. A CHECK ("endDate" >=
// "startDate") is enforced at the database level too - this Prisma version's
// schema DSL has no @@check attribute, so it's added via raw SQL in this
// model's migration instead (see migration.sql).
model Booking {
  id        Int           @id @default(autoincrement())
  dressId   Int
  renterId  Int?
  size      String?
  startDate DateTime
  endDate   DateTime
  price     Int?
  status    BookingStatus @default(INTERESTED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  dress  Dress @relation(fields: [dressId], references: [id], onDelete: Cascade)
  renter User? @relation(fields: [renterId], references: [id], onDelete: SetNull)

  messages BookingMessage[]

  @@index([dressId, startDate, endDate])
  @@index([renterId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  INTERESTED
  RENTED
}

// In-app coordination thread for one Booking (e.g. arranging a fitting
// before closing a rental) - kept inside the platform on purpose rather than
// pushing renter/owner to an external channel. senderId is required (not
// nullable), so onDelete: Cascade is the only valid choice for it - unlike
// Booking.renter, there's no "keep the row with a null sender" option here.
model BookingMessage {
  id        Int      @id @default(autoincrement())
  bookingId Int
  senderId  Int
  body      String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// An owner-initiated hold on a date range for their own reasons (cleaning,
// personal use) - deliberately NOT a Booking, since Booking now represents a
// real renter transaction (see BookingMessage above). Keeping this as its
// own model means "a customer rented this" and "the owner blocked this" can
// never be confused with each other by anything that reads Booking.status.
model DressAvailabilityBlock {
  id        Int      @id @default(autoincrement())
  dressId   Int
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  dress Dress @relation(fields: [dressId], references: [id], onDelete: Cascade)

  @@index([dressId])
}
